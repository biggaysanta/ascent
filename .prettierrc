{
  "plugins": ["prettier-plugin-go-template"],
  "overrides": [
    {
      "files": ["*.html", "layouts/**/*.html", "themes/**/*.html"],
      "options": {
        "parser": "go-template"
      }
    }
  ],
  "goTemplateBracketSpacing": true,
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": false,
  "printWidth": 100
}
